{
  "description": "Project scenario/environment data for shared runtime verification. Producer input flags require final integration mapping; this file executes nothing.",
  "scenarios": "harness/END-TO-END.md",
  "holdout": ".factory/holdout/HOLDOUT.md",
  "driver": "http",
  "http": {
    "start": "node --experimental-strip-types --no-warnings apps/server/src/main.ts",
    "health_path": "/health",
    "health_contains": "\"status\":\"ok\"",
    "boot_timeout_s": 45,
    "env": {
      "PORT": "{port}",
      "SPORTSJACK_DB": "{state}/sportsjack.sqlite",
      "SPORTSJACK_REPLAY": "2025_22_SEA_NE",
      "SPORTSJACK_REPLAY_SPEED": "60",
      "SPORTSJACK_BREAK_SECONDS": "5",
      "SPORTSJACK_TEST_CONTROLS": "1"
    }
  },
  "cli": {
    "invoke": "",
    "smoke_args": "--version",
    "smoke_contains": ""
  },
  "library": {
    "import_check": ""
  },
  "browser": {
    "install_check": "",
    "install_hint": ""
  },
  "requirements": {
    "fresh_environment_per": [
      "runtime",
      "holdout",
      "retry",
      "mutation"
    ],
    "fresh_database": true,
    "assertion_evidence_required": true,
    "cleanup": "Owned process and environment cleanup must be verified by the producer"
  }
}
